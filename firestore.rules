rules_version = '2';

// Firestore-Sicherheitsregeln für die Hochzeits-App.
// Einfaches Modell, passend für eine private Familien-/Freundes-App:
// - config, categories, guests: von allen lesbar (nötig für die Startseite & Kategorien),
//   aber nur von eingeloggten Admins (Lucie & Timmy) änderbar.
// - responses: jeder Gast darf sein eigenes Antwort-Dokument anlegen/ändern und per
//   direktem Dokument-Zugriff (get) lesen, damit eigene Angaben beim erneuten Öffnen
//   der Seite vorausgefüllt sind. Das komplette Auflisten aller Antworten (list, z.B.
//   für den Admin-Tab "Antworten" und den CSV-Export) bleibt nur eingeloggten Admins
//   vorbehalten, damit Gäste nicht die Angaben anderer Gäste einsehen können.
//
// Hinweis: Das ist bewusst simpel gehalten (kein Fein-Schutz pro einzelnem Gast-Dokument
// über eine eigene Gast-Anmeldung), ausreichend für eine private Hochzeits-Seite mit
// "geheimem Link". Ein Gast könnte nur dann die Antwort eines anderen Gastes lesen, wenn
// er dessen zufällig generierte Dokument-ID kennt.

service cloud.firestore {
  match /databases/{database}/documents {

    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sections/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /guests/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /responses/{docId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    match /photos/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
